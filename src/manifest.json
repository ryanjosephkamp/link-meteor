{
  "manifest_version": 3,
  "name": "Link Meteor",
  "version": "0.3.0",
  "description": "Capture links with their anchor text, organize local research collections, and export them your way. Free, private, and local.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "sidePanel", "contextMenus", "clipboardWrite"],
  "optional_permissions": ["tabs", "bookmarks"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Link Meteor", "default_icon": {"16":"icons/16.png","32":"icons/32.png"} },
  "side_panel": { "default_path": "ui/workbench.html" },
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "commands": {
    "select-region": {
      "suggested_key": {"default":"Alt+Shift+L","mac":"Alt+Shift+L"},
      "description": "Select a region of links"
    }
  },
  "incognito": "not_allowed",
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"}
}
